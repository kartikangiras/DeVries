# Copy to .env and change the password. .env is ignored by git.

# FalkorDB as seen from processes on this machine. Inside the compose network it is falkordb:6379.
# The host port is 6380 because many machines already run a Redis on 6379.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=change-me

# Ports docker compose publishes on 127.0.0.1
FALKORDB_HOST_PORT=6380
FALKORDB_BROWSER_PORT=3000
APP_PORT=8000
# APP_BIND=0.0.0.0            # publish the app beyond this machine (the deployment)

# The auditor's model. With no key every run is scripted (the baseline search), and the UI says so.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium           # low | medium | high | xhigh | max | none (none: do not send the parameter)
# LLM_DAILY_BUDGET_USD=5      # past this estimated spend, new runs are scripted until the next UTC day

# External MCP clients of http://<app>/mcp must send "Authorization: Bearer <token>". Unset leaves /mcp open:
# fine on localhost, not on a public address.
# CISTERN_MCP_TOKEN=

# Visitor sessions (private copies of the scenario graphs)
# SESSION_MAX=30
# SESSION_TTL_MIN=60
# SESSION_RUNS=3              # audit runs with a model, per session
# SESSION_QUESTIONS=10
# COOKIE_SECURE=true          # when the app is served over https

# A public address. The import takes only what is pasted and launches nothing, no file is ever written,
# imports and runs are rationed per address, and visitor copies are dropped past the memory ceiling.
# CISTERN_PUBLIC=false
# RATE_IMPORTS_PER_HOUR=6
# RATE_RUNS_PER_HOUR=30
# FALKORDB_MEMORY_CEILING_MB=   # unset: no ceiling
# IMPORT_DIR=.imports           # where a public site keeps what visitors paste
# IMPORT_TIMEOUT_S=10           # for a pasted server with a url
# IMPORT_MAX_TOOLS=200

# At start: wait this long for FalkorDB, then audit each shared scenario to its first proposal, scripted.
# STARTUP_DB_WAIT_S=60
# PRERUN_AUDITS=true

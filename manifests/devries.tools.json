{
  "server": "devries",
  "synthetic": false,
  "note": "DeVries's own MCP server, as it answers tools/list. Regenerate with `make self-manifest`.",
  "tools": [
    {
      "name": "apply_fix",
      "description": "Apply a mitigation that a person has approved: change the scenario's config and rebuild the flow projection. Fails with needs_approval until a person approves it, and with stale if the config changed since and the plan no longer passes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "mitigation_id": {
            "title": "Mitigation Id",
            "type": "string"
          }
        },
        "required": [
          "scenario",
          "mitigation_id"
        ],
        "title": "apply_fixArguments"
      }
    },
    {
      "name": "find_injection_paths",
      "description": "Injection findings: an untrusted data source that can reach a high-impact resource. Each comes with up to three concrete paths, hop by hop, with the rule behind each hop. Pass source_id to look at one source only. Reads only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Id"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "find_injection_pathsArguments"
      }
    },
    {
      "name": "find_trifecta_agents",
      "description": "Lethal-trifecta findings: an agent reached by untrusted content and by private data that can also reach a resource outside the organisation. Each comes with three legs: untrusted in, private in, exit out. Reads only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "find_trifecta_agentsArguments"
      }
    },
    {
      "name": "list_scenarios",
      "description": "List the scenario graphs that can be audited, with node and open-finding counts.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "title": "list_scenariosArguments"
      }
    },
    {
      "name": "propose_fix",
      "description": "Record a fix plan for a person to approve, with the reason for choosing it. The plan is verified again here and refused if it does not pass (error fix_failed, with the verdict). Changes nothing in the scenario's config: only a person can approve.",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "DropRead": {
            "description": "The tool stops reading this data source.",
            "properties": {
              "kind": {
                "const": "drop_read",
                "title": "Kind",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              },
              "source_id": {
                "title": "Source Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "tool_id",
              "source_id"
            ],
            "title": "DropRead",
            "type": "object"
          },
          "FixPlan": {
            "properties": {
              "fixes": {
                "items": {
                  "discriminator": {
                    "mapping": {
                      "drop_read": "#/$defs/DropRead",
                      "gate_call": "#/$defs/GateCall",
                      "quarantine_delegation": "#/$defs/QuarantineDelegation",
                      "revoke_call": "#/$defs/RevokeCall",
                      "split_agent": "#/$defs/SplitAgent"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/GateCall"
                    },
                    {
                      "$ref": "#/$defs/RevokeCall"
                    },
                    {
                      "$ref": "#/$defs/QuarantineDelegation"
                    },
                    {
                      "$ref": "#/$defs/DropRead"
                    },
                    {
                      "$ref": "#/$defs/SplitAgent"
                    }
                  ]
                },
                "maxItems": 3,
                "minItems": 1,
                "title": "Fixes",
                "type": "array"
              }
            },
            "required": [
              "fixes"
            ],
            "title": "FixPlan",
            "type": "object"
          },
          "GateCall": {
            "description": "A person must approve each call of this tool by this agent.",
            "properties": {
              "kind": {
                "const": "gate_call",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "tool_id"
            ],
            "title": "GateCall",
            "type": "object"
          },
          "QuarantineDelegation": {
            "description": "The delegate returns only structured fields to its delegator (the dual-LLM pattern).",
            "properties": {
              "kind": {
                "const": "quarantine_delegation",
                "title": "Kind",
                "type": "string"
              },
              "from_agent_id": {
                "title": "From Agent Id",
                "type": "string"
              },
              "to_agent_id": {
                "title": "To Agent Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "from_agent_id",
              "to_agent_id"
            ],
            "title": "QuarantineDelegation",
            "type": "object"
          },
          "RevokeCall": {
            "description": "The agent loses this tool.",
            "properties": {
              "kind": {
                "const": "revoke_call",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "tool_id"
            ],
            "title": "RevokeCall",
            "type": "object"
          },
          "SplitAgent": {
            "description": "The agent keeps its acting tools and hands these reading tools to a new reader agent, whose\nresults come back quarantined. Only tools whose capability is `read` may move.",
            "properties": {
              "kind": {
                "const": "split_agent",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "reader_tool_ids": {
                "items": {
                  "type": "string"
                },
                "maxItems": 8,
                "minItems": 1,
                "title": "Reader Tool Ids",
                "type": "array"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "reader_tool_ids"
            ],
            "title": "SplitAgent",
            "type": "object"
          }
        },
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "finding_ids": {
            "items": {
              "type": "string"
            },
            "title": "Finding Ids",
            "type": "array"
          },
          "plan": {
            "$ref": "#/$defs/FixPlan"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": [
          "scenario",
          "finding_ids",
          "plan",
          "rationale"
        ],
        "title": "propose_fixArguments"
      }
    },
    {
      "name": "rank_chokepoints",
      "description": "Where to cut. 'paths' ranks the config edges (grants, delegations, reads) that the evidence paths of the given findings cross, and names the fixes that act on each. 'betweenness' ranks agents and tools by centrality on the flow layer, as context. 'mincut' gives the cheapest set of edges whose removal separates every untrusted source from every high-impact resource at once, by max flow (it ignores finding_ids). Reads only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "finding_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Finding Ids"
          },
          "method": {
            "default": "paths",
            "enum": [
              "paths",
              "betweenness",
              "mincut"
            ],
            "title": "Method",
            "type": "string"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "rank_chokepointsArguments"
      }
    },
    {
      "name": "rule_of_two",
      "description": "Meta's Agents Rule of Two, per agent: A, untrusted input reaches it; B, private data reaches it; C, it can act on a resource (external or not). An agent with all three that runs an autonomous workflow is listed first. Context for choosing where to look; the findings are the verdicts. Reads only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "rule_of_twoArguments"
      }
    },
    {
      "name": "scan",
      "description": "Rebuild the flow projection of a scenario, find every injection path and every lethal-trifecta agent, and store the findings. Returns counts and finding ids. Call this first; it writes findings only, never config.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "scanArguments"
      }
    },
    {
      "name": "simulate_mitigation",
      "description": "Test a fix plan in a sandbox copy of the scenario. Reports whether the listed findings are resolved, whether any new finding appears and whether any workflow breaks, with the reason when the plan fails. Never changes the scenario. A plan is one to three fixes: revoke_call removes a grant (cost 1); gate_call makes a person approve each call (cost 2); quarantine_delegation makes a delegate return only structured fields (cost 2); drop_read stops a tool reading a data source (cost 3); split_agent moves an agent's reading tools to a quarantined reader (cost 4).",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "DropRead": {
            "description": "The tool stops reading this data source.",
            "properties": {
              "kind": {
                "const": "drop_read",
                "title": "Kind",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              },
              "source_id": {
                "title": "Source Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "tool_id",
              "source_id"
            ],
            "title": "DropRead",
            "type": "object"
          },
          "FixPlan": {
            "properties": {
              "fixes": {
                "items": {
                  "discriminator": {
                    "mapping": {
                      "drop_read": "#/$defs/DropRead",
                      "gate_call": "#/$defs/GateCall",
                      "quarantine_delegation": "#/$defs/QuarantineDelegation",
                      "revoke_call": "#/$defs/RevokeCall",
                      "split_agent": "#/$defs/SplitAgent"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/GateCall"
                    },
                    {
                      "$ref": "#/$defs/RevokeCall"
                    },
                    {
                      "$ref": "#/$defs/QuarantineDelegation"
                    },
                    {
                      "$ref": "#/$defs/DropRead"
                    },
                    {
                      "$ref": "#/$defs/SplitAgent"
                    }
                  ]
                },
                "maxItems": 3,
                "minItems": 1,
                "title": "Fixes",
                "type": "array"
              }
            },
            "required": [
              "fixes"
            ],
            "title": "FixPlan",
            "type": "object"
          },
          "GateCall": {
            "description": "A person must approve each call of this tool by this agent.",
            "properties": {
              "kind": {
                "const": "gate_call",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "tool_id"
            ],
            "title": "GateCall",
            "type": "object"
          },
          "QuarantineDelegation": {
            "description": "The delegate returns only structured fields to its delegator (the dual-LLM pattern).",
            "properties": {
              "kind": {
                "const": "quarantine_delegation",
                "title": "Kind",
                "type": "string"
              },
              "from_agent_id": {
                "title": "From Agent Id",
                "type": "string"
              },
              "to_agent_id": {
                "title": "To Agent Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "from_agent_id",
              "to_agent_id"
            ],
            "title": "QuarantineDelegation",
            "type": "object"
          },
          "RevokeCall": {
            "description": "The agent loses this tool.",
            "properties": {
              "kind": {
                "const": "revoke_call",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "tool_id"
            ],
            "title": "RevokeCall",
            "type": "object"
          },
          "SplitAgent": {
            "description": "The agent keeps its acting tools and hands these reading tools to a new reader agent, whose\nresults come back quarantined. Only tools whose capability is `read` may move.",
            "properties": {
              "kind": {
                "const": "split_agent",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "reader_tool_ids": {
                "items": {
                  "type": "string"
                },
                "maxItems": 8,
                "minItems": 1,
                "title": "Reader Tool Ids",
                "type": "array"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "reader_tool_ids"
            ],
            "title": "SplitAgent",
            "type": "object"
          }
        },
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/FixPlan"
          },
          "finding_ids": {
            "items": {
              "type": "string"
            },
            "title": "Finding Ids",
            "type": "array"
          }
        },
        "required": [
          "scenario",
          "plan",
          "finding_ids"
        ],
        "title": "simulate_mitigationArguments"
      }
    },
    {
      "name": "trust_zones",
      "description": "Group the scenario's nodes into zones that can affect each other at all (weakly connected components of the flow layer). A blast zone holds both an untrusted source and a high-impact resource.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "trust_zonesArguments"
      }
    },
    {
      "name": "what_if",
      "description": "Apply hypothetical changes to a sandbox copy and report which findings they would introduce or resolve and which workflows they would break. Besides the five fixes, a change can widen the config: grant_call gives an agent a tool, add_delegation lets one agent delegate to another; or ask what removing a whole server would do: drop_server takes every grant to its tools away. Never changes the scenario.",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "AddDelegation": {
            "description": "What-if only: let one agent delegate to another.",
            "properties": {
              "kind": {
                "const": "add_delegation",
                "title": "Kind",
                "type": "string"
              },
              "from_agent_id": {
                "title": "From Agent Id",
                "type": "string"
              },
              "to_agent_id": {
                "title": "To Agent Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "from_agent_id",
              "to_agent_id"
            ],
            "title": "AddDelegation",
            "type": "object"
          },
          "DropRead": {
            "description": "The tool stops reading this data source.",
            "properties": {
              "kind": {
                "const": "drop_read",
                "title": "Kind",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              },
              "source_id": {
                "title": "Source Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "tool_id",
              "source_id"
            ],
            "title": "DropRead",
            "type": "object"
          },
          "DropServer": {
            "description": "What if this server were removed: every grant to its tools goes. A question for a sandbox, never a fix.",
            "properties": {
              "kind": {
                "const": "drop_server",
                "title": "Kind",
                "type": "string"
              },
              "server_id": {
                "title": "Server Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "server_id"
            ],
            "title": "DropServer",
            "type": "object"
          },
          "GateCall": {
            "description": "A person must approve each call of this tool by this agent.",
            "properties": {
              "kind": {
                "const": "gate_call",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "tool_id"
            ],
            "title": "GateCall",
            "type": "object"
          },
          "GrantCall": {
            "description": "What-if only: give an agent a tool it does not have.",
            "properties": {
              "kind": {
                "const": "grant_call",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "tool_id"
            ],
            "title": "GrantCall",
            "type": "object"
          },
          "QuarantineDelegation": {
            "description": "The delegate returns only structured fields to its delegator (the dual-LLM pattern).",
            "properties": {
              "kind": {
                "const": "quarantine_delegation",
                "title": "Kind",
                "type": "string"
              },
              "from_agent_id": {
                "title": "From Agent Id",
                "type": "string"
              },
              "to_agent_id": {
                "title": "To Agent Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "from_agent_id",
              "to_agent_id"
            ],
            "title": "QuarantineDelegation",
            "type": "object"
          },
          "RevokeCall": {
            "description": "The agent loses this tool.",
            "properties": {
              "kind": {
                "const": "revoke_call",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "tool_id": {
                "title": "Tool Id",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "tool_id"
            ],
            "title": "RevokeCall",
            "type": "object"
          },
          "SplitAgent": {
            "description": "The agent keeps its acting tools and hands these reading tools to a new reader agent, whose\nresults come back quarantined. Only tools whose capability is `read` may move.",
            "properties": {
              "kind": {
                "const": "split_agent",
                "title": "Kind",
                "type": "string"
              },
              "agent_id": {
                "title": "Agent Id",
                "type": "string"
              },
              "reader_tool_ids": {
                "items": {
                  "type": "string"
                },
                "maxItems": 8,
                "minItems": 1,
                "title": "Reader Tool Ids",
                "type": "array"
              }
            },
            "required": [
              "kind",
              "agent_id",
              "reader_tool_ids"
            ],
            "title": "SplitAgent",
            "type": "object"
          }
        },
        "properties": {
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "changes": {
            "items": {
              "discriminator": {
                "mapping": {
                  "add_delegation": "#/$defs/AddDelegation",
                  "drop_read": "#/$defs/DropRead",
                  "drop_server": "#/$defs/DropServer",
                  "gate_call": "#/$defs/GateCall",
                  "grant_call": "#/$defs/GrantCall",
                  "quarantine_delegation": "#/$defs/QuarantineDelegation",
                  "revoke_call": "#/$defs/RevokeCall",
                  "split_agent": "#/$defs/SplitAgent"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/GateCall"
                },
                {
                  "$ref": "#/$defs/RevokeCall"
                },
                {
                  "$ref": "#/$defs/QuarantineDelegation"
                },
                {
                  "$ref": "#/$defs/DropRead"
                },
                {
                  "$ref": "#/$defs/SplitAgent"
                },
                {
                  "$ref": "#/$defs/GrantCall"
                },
                {
                  "$ref": "#/$defs/AddDelegation"
                },
                {
                  "$ref": "#/$defs/DropServer"
                }
              ]
            },
            "title": "Changes",
            "type": "array"
          }
        },
        "required": [
          "scenario",
          "changes"
        ],
        "title": "what_ifArguments"
      }
    }
  ]
}

{
  "server": "ats",
  "synthetic": true,
  "note": "Synthetic manifest in the shape of an MCP tools/list result. No public server stands behind it.",
  "tools": [
    {
      "name": "list_applications",
      "description": "List the applications for a job: id, stage and date. The content comes from get_application.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_application",
      "description": "Fetch one application: the candidate's details, the CV text and the cover letter as the applicant wrote them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          }
        },
        "required": [
          "application_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "email_candidate",
      "description": "Send an email to a candidate from the recruiting address.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "application_id",
          "subject",
          "body"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "move_stage",
      "description": "Move an application to another stage of the pipeline.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        },
        "required": [
          "application_id",
          "stage"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    }
  ]
}
